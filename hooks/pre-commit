#!/bin/sh
# Cursor SDK pre-commit: New Zamn auth-gate + schema-aware security audit.
# Bypass once with: git commit --no-verify
set -e

STARTER="C:/Users/asale/projects/cursor-sdk-starter"
REPO_ROOT="$(git rev-parse --show-toplevel)"
TSX="$STARTER/node_modules/tsx/dist/cli.mjs"

# Re-attach stdin to the terminal so auth-gate can prompt interactively.
# Git pre-commit hooks often default to stdin=/dev/null; opening /dev/tty
# must NOT abort the hook under `set -e` when it isn't available (CI,
# agent shells, Windows environments without a tty).
if [ -t 1 ] && [ -r /dev/tty ]; then
  if ! { exec 0</dev/tty; } 2>/dev/null; then
    :
  fi
fi

# Step 1: 2-way authorisation gate (skips silently when no schema change detected).
node "$TSX" "$STARTER/scripts/auth-gate.ts" "$REPO_ROOT"

# Step 2: schema-aware security audit (RULE-1 through RULE-6 + soft .cursorrules).
exec node "$TSX" "$STARTER/scripts/enforce-schema.ts" "$REPO_ROOT"
