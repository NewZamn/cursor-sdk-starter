  "dependencies": {
    "@cursor/sdk": "^1.0.11",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.11"
  }
}
